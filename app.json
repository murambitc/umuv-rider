{
  "expo": {
    "name": "uMuv Rider",
    "slug": "umuv-rider",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "scheme": "umuvrider",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logo.png",
      "bitcode": false,
      "bundleIdentifier": "com.murambitc.umuvrider",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "uMuv Rider uses your location to set your pickup point and show nearby drivers.",
        "NSCameraUsageDescription": "uMuv Rider needs camera access for payment and support photos.",
        "NSPhotoLibraryUsageDescription": "uMuv Rider needs photo library access for support attachments.",
        "NSMicrophoneUsageDescription": "uMuv Rider needs microphone access for in-app calls with drivers.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "googleMapsApiKey": "AIzaSyC_lWD18GJzaOe4zsfylbRTpd7b5YLWIs4"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFB020",
        "foregroundImage": "./assets/images/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.RECORD_AUDIO",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.BLUETOOTH"
      ],
      "package": "com.murambitc.umuvrider"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFB020",
          "image": "./assets/images/logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "uMuv Rider uses your location to set your pickup point and show nearby drivers."
        }
      ],
      "@config-plugins/react-native-webrtc",
      [
        "./plugins/withGoogleMapsApiKey",
        {
          "apiKey": "AIzaSyC_lWD18GJzaOe4zsfylbRTpd7b5YLWIs4"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "usesCleartextTraffic": true,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-localization",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "97416041-58f6-4ca5-94b6-24e49458377e"
      }
    },
    "owner": "tawandaclementmurambi"
  }
}